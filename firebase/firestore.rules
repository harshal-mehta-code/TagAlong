rules_version = '2';

// TagAlong community rules. NOT YET DEPLOYED — the console project is likely
// still in test mode. Deploy with the Firebase CLI when ready.
service cloud.firestore {
  match /databases/{database}/documents {

    // A tag: readable by any signed-in user. Anyone signed in may create it or
    // update its completion metadata.
    //
    // TODO(security): this is intentionally loose for the first multiplayer
    // milestone — ANY authed user can overwrite ANY tag doc (title/key/parts/
    // isComplete), because completeness is recomputed client-side. Tighten once
    // a Cloud Function owns completion (server-authoritative parts/isComplete)
    // and creatorUid is pinned on create.
    match /tags/{tagId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;

      // A take: readable by any signed-in user; writable only by its owner.
      match /takes/{takeId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.ownerUid == request.auth.uid;
        allow update: if request.auth != null
                      && resource.data.ownerUid == request.auth.uid;
        allow delete: if false;
      }
    }
  }
}
