rules_version = '2';

// TagAlong take media. NOT YET DEPLOYED — the console bucket is likely still in
// test mode. Deploy with the Firebase CLI when ready.
service firebase.storage {
  match /b/{bucket}/o {

    // Take movies live flat under takes/{takeUUID}.mov. Any signed-in user may
    // read (feed playback + join downloads); writes are limited to that path.
    //
    // TODO(security): does not verify the writer owns the matching Firestore
    // take doc (no cross-service check in Storage rules). Acceptable for the
    // first milestone; revisit alongside the Firestore rules TODO.
    match /takes/{takeFile} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && takeFile.matches('.*[.]mov');
    }

    match /{allOther=**} {
      allow read, write: if false;
    }
  }
}
